{
  "name": "dsh-plugin-goldboard",
  "version": "1.15.0",
  "description": "Gold dashboard and intraday decision support for DeepSeek Harness Web and Desktop: a sidebar Gold Board page with quotes, plan/risk panel, replay diagnostics, isolated strategy experiments, model analysis, data-source health and settings.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./market-data": {
      "default": "./lib/market-data.js"
    },
    "./execution": {
      "default": "./lib/execution.js"
    },
    "./risk": {
      "default": "./lib/risk.js"
    },
    "./target-trail": {
      "default": "./lib/target-trail.js"
    },
    "./ledger": {
      "default": "./lib/signal-ledger.js"
    },
    "./history": {
      "default": "./lib/historical-store.js"
    },
    "./replay": {
      "default": "./lib/replay.js"
    },
    "./strategy": {
      "default": "./lib/strategy.js"
    },
    "./experiments": {
      "default": "./lib/experiments.js"
    },
    "./factors": {
      "default": "./lib/factors.js"
    },
    "./testing": {
      "default": "./lib/testing.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": {
      "default": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "DESIGN.md",
    "README-en.md",
    "docs/optimization-roadmap.md",
    "docs/stage-1-implementation-plan.md",
    "docs/stage-2-implementation-plan.md",
    "docs/stage-3-implementation-plan.md",
    "docs/stage-4-implementation-plan.md",
    "docs/v1.11.0-strategy-optimization.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "deepseek-ai",
    "cordis",
    "plugin",
    "gold",
    "gold-price",
    "au9999",
    "xau",
    "dashboard",
    "trading-signals",
    "web-ui",
    "goldboard",
    "replay",
    "strategy-stats",
    "agent",
    "ai",
    "ui-plugin",
    "sidebar",
    "sidebar-page",
    "desktop",
    "bundle",
    "javascript",
    "react",
    "open-source"
  ],
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-ling/dsh-plugin-goldboard.git"
  },
  "bugs": {
    "url": "https://github.com/c-ling/dsh-plugin-goldboard/issues"
  },
  "homepage": "https://github.com/c-ling/dsh-plugin-goldboard#readme",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
